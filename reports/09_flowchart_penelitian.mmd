    subgraph S1["TAHAP 1 - DATA MENTAH"]
        A["Dataset/indotoxic2024_annotated_data-3.jsonl<br/>43.692 baris anotasi (34,6 MB, JSONL)<br/>19 anotator (ID 1-21, tanpa 14 &amp; 17)<br/>28.449 teks unik (text_id)<br/>1 baris = 1 anotasi, bukan 1 teks<br/>6 label biner + topik + demografi anotator"]
        A0["Dataset/indotoxic2024_annotator_data.jsonl<br/>19 baris profil demografi anotator"]
    end

    subgraph S2["TAHAP 2 - PEMBERSIHAN (notebook step 3)"]
