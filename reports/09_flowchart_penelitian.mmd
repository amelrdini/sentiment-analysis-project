        B2["1 unit teks kosong dibuang (text_id 2-1256)"]
        B3["1 unit teks kosong dipulihkan<br/>(text_id 103-150)"]
        C["43.520 baris valid<br/>28.448 teks unik<br/>topic '1' dinormalisasi ke UNKNOWN<br/>(3.903 baris UNKNOWN)"]
    end

    subgraph S3["TAHAP 3 - AGREGASI LABEL"]
        D["majority_safety_first per text_id<br/>label = 1 jika v/n &gt;= 0,5<br/>(tie genap di-resolve ke POSITIF,<br/>semua 6 label)"]
        D1["Flag tie_break_applied_label<br/>disimpan per label (ablasi nanti)"]
        E["28.448 unit teks berlabel final<br/>toxicity 4.414 positif (15,5%) | tie 1.996<br/>profanity 904 (3,2%) | tie 519<br/>threat 1.068 (3,8%) | tie 945<br/>insults 2.260 (7,9%) | tie 1.376<br/>identity_attack 2.186 (7,7%) | tie 1.242<br/>sexually_explicit 151 (0,5%) | tie 95"]
    end

    subgraph S4["TAHAP 4 - GROUPING & SPLIT"]
        F["group_id dari konten dinormalisasi<br/>(lowercase, whitespace &amp; kutip dibersihkan)<br/>26.157 grup unik<br/>4.425 unit di grup multi-anggota (15,6%)"]
        G["Iterative Stratification scikit-multilearn<br/>order=1, rasio 70:15:15, seed 42<br/>stratifikasi di level grup (label OR)"]
        H["TRAIN 19.986 unit / 18.309 grup<br/>VAL 4.229 unit / 3.924 grup<br/>TEST 4.233 unit / 3.924 grup<br/>Leakage check: 0 grup lintas split"]
    end

    subgraph S5["TAHAP 5 - EDA (notebook step 4, 5, 6)"]
        I["23 figur di reports/figures/<br/>01-13: EDA konten (distribusi 6 label,<br/>co-occurrence, panjang teks, wordcloud)<br/>14-16: toxic vs non-toxic, agreement,<br/>bias demografi 19 anotator<br/>17-21: EDA pasca-preprocessing<br/>(fitur per label, kosakata, slang)"]
    end

    subgraph S6["TAHAP 6 - PREPROCESSING TEKS (src/preprocessing.py)"]
        J["Input: data/processed/{split}.jsonl<br/>10 fitur struktural dihitung dari teks asli:<br/>caps_ratio, n_allcaps_word, n_elongated,<br/>n_url, n_mention, n_hashtag, n_emoji,<br/>n_word, n_char, n_slang_replaced"]
        K["text_clean:<br/>URL &amp; mention dihapus (jumlah dicatat)<br/>hashtag: simbol # dibuang, kata disimpan<br/>emoji dihitung lalu dihapus<br/>huruf berulang 3+ dikompres ke 2<br/>lowercase<br/>ht -&gt; hashtag (pengecualian kamus)"]
        L["Normalisasi slang word-by-word<br/>kamus new_kamusalay.csv (15.166 entri)<br/>(Ibrohim &amp; Budi 2019, W19-3506)"]
        M["Output: {split}_preprocessed.jsonl<br/>kolom text (asli) + text_clean + fitur<br/>needs_manual_review: 13 teks<br/>(n_slang_replaced &gt;= 50:<br/>train 5, val 4, test 4)<br/>TANPA stemming &amp; stopword removal"]
    end

    subgraph S7["TAHAP 7 - FINE-TUNING (DIRENCANAKAN)"]
        N["model A: indobenchmark/indobert-base-p1<br/>WordPiece 50.000, uncased, ~124 jt param"]
        N2["model B: indolem/indobertweet-base-uncased<br/>WordPiece 31.923, ~124 jt param"]
        O["Protokol identik kedua model:<br/>input text_clean, max_length 128<br/>2 task paralel:<br/>biner toxicity (head 2 unit)<br/>multi-label 5 label (head 5 sigmoid)<br/>BCEWithLogitsLoss (multi-label)<br/>AdamW lr 2e-5, batch 32, maks 4 epoch<br/>early stopping val macro-F1, seed 42"]
        O1["Paralel 2 task:<br/>Task biner (toxicity, 2 kelas)<br/>Task multi-label (5 label)<br/>checkpoint: models/indobert/ &amp;<br/>models/indobertweet/"]
    end

    subgraph S8["TAHAP 8 - EVALUASI (DIRENCANAKAN)"]
        P["Test set hold-out: 4.233 teks<br/>classification_report sklearn per label<br/>+ macro/micro/weighted F1<br/>Hamming loss, subset accuracy<br/>ROC-AUC &amp; PR-AUC per label<br/>confusion matrix per label<br/>(multilabel_confusion_matrix)<br/>bootstrap 1.000x CI 95% + McNemar"]
    end

